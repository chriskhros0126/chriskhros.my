---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin // chriskhros.my">
  <div class="max-w-2xl mx-auto px-4 py-10 font-mono text-xs text-neutral-300">

    <!-- Auth -->
    <div class="mb-6 pb-4 border-b border-neutral-700">
      <div class="flex items-center gap-2 mb-2">
        <label for="tk" class="text-neutral-500">Admin Key</label>
        <input type="password" id="tk" class="flex-1 px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none focus:border-blue-500" />
        <button type="button" id="test-btn" class="px-2 py-1 bg-neutral-700 border border-neutral-600 rounded hover:bg-neutral-600 text-neutral-300">Test</button>
        <button type="button" id="save-btn" class="px-2 py-1 bg-neutral-700 border border-neutral-600 rounded hover:bg-neutral-600 text-neutral-300">Save</button>
      </div>
      <div id="auth-status" class="text-neutral-500">—</div>
    </div>

    <!-- Upload -->
    <form id="upload-form" class="mb-6 pb-4 border-b border-neutral-700 space-y-2">
      <div class="text-neutral-500 mb-1">Upload Binary</div>
      <input type="file" id="file-input" class="block w-full text-neutral-400 file:mr-2 file:py-1 file:px-2 file:rounded file:border file:border-neutral-600 file:bg-neutral-800 file:text-neutral-300 file:text-xs" />
      <div class="grid grid-cols-2 gap-2">
        <input type="text" id="m-title" placeholder="Title" class="px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none focus:border-blue-500" />
        <input type="text" id="m-version" placeholder="Version" class="px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none focus:border-blue-500" />
        <select id="m-platform" class="px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none">
          <option>Windows</option><option>macOS</option><option>Linux</option><option>Web</option><option>Cross-Platform</option>
        </select>
        <select id="m-category" class="px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none">
          <option>Binaries</option><option>Web Apps</option>
        </select>
      </div>
      <textarea id="m-desc" placeholder="Description" rows="2" class="w-full px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none focus:border-blue-500 resize-none"></textarea>
      <input type="text" id="m-tags" placeholder="Tags (comma separated)" class="w-full px-2 py-1 bg-neutral-800 border border-neutral-600 rounded text-neutral-200 focus:outline-none focus:border-blue-500" />
      <!-- Progress -->
      <div id="progress-wrap" class="hidden">
        <div class="w-full h-1.5 bg-neutral-800 rounded overflow-hidden">
          <div id="progress-bar" class="h-full bg-blue-500 transition-all duration-100" style="width:0%"></div>
        </div>
        <div id="progress-text" class="text-neutral-500 mt-0.5">0%</div>
      </div>
      <div id="upload-status" class="text-neutral-500"></div>
      <button type="submit" id="upload-btn" class="w-full py-1.5 bg-neutral-700 border border-neutral-600 rounded hover:bg-neutral-600 text-neutral-200 disabled:opacity-40">Upload</button>
    </form>

    <!-- Catalog -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <span class="text-neutral-500">Catalog</span>
        <div class="flex gap-1">
          <button type="button" id="refresh-btn" class="px-2 py-0.5 bg-neutral-700 border border-neutral-600 rounded hover:bg-neutral-600 text-neutral-300">Refresh</button>
          <button type="button" id="clear-btn" class="px-2 py-0.5 bg-neutral-800 border border-red-900 rounded hover:bg-red-900/30 text-red-400">Clear All</button>
        </div>
      </div>
      <div id="catalog" class="space-y-1">
        <div class="text-neutral-600 py-4 text-center">loading...</div>
      </div>
    </div>

  </div>
</Layout>

<script>
  const tk = document.getElementById("tk") as HTMLInputElement;
  const testBtn = document.getElementById("test-btn");
  const saveBtn = document.getElementById("save-btn");
  const authStatus = document.getElementById("auth-status");
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const form = document.getElementById("upload-form") as HTMLFormElement;
  const uploadBtn = document.getElementById("upload-btn") as HTMLButtonElement;
  const progressWrap = document.getElementById("progress-wrap");
  const progressBar = document.getElementById("progress-bar");
  const progressText = document.getElementById("progress-text");
  const uploadStatus = document.getElementById("upload-status");
  const refreshBtn = document.getElementById("refresh-btn");
  const clearBtn = document.getElementById("clear-btn");
  const catalog = document.getElementById("catalog");

  const mTitle = document.getElementById("m-title") as HTMLInputElement;
  const mVersion = document.getElementById("m-version") as HTMLInputElement;
  const mPlatform = document.getElementById("m-platform") as HTMLSelectElement;
  const mCategory = document.getElementById("m-category") as HTMLSelectElement;
  const mDesc = document.getElementById("m-desc") as HTMLTextAreaElement;
  const mTags = document.getElementById("m-tags") as HTMLInputElement;

  function getToken() { return tk.value.trim(); }

  // Restore
  const saved = sessionStorage.getItem("ck_admin_key") || "";
  if (saved) tk.value = saved;

  saveBtn?.addEventListener("click", () => {
    const v = getToken();
    if (v) { sessionStorage.setItem("ck_admin_key", v); if (authStatus) authStatus.textContent = "saved"; }
    else { sessionStorage.removeItem("ck_admin_key"); if (authStatus) authStatus.textContent = "cleared"; }
  });

  testBtn?.addEventListener("click", async () => {
    const v = getToken();
    if (!v) { if (authStatus) authStatus.textContent = "enter a key first"; return; }
    if (authStatus) authStatus.textContent = "testing...";
    try {
      const r = await fetch("/api/tools?verify=true", { headers: { "x-admin-token": v } });
      const d = await r.json().catch(() => ({}));
      if (authStatus) authStatus.textContent = r.ok ? "✓ verified" : `✗ ${d.error || "failed"}`;
    } catch (e: any) {
      if (authStatus) authStatus.textContent = `✗ ${e.message}`;
    }
  });

  // Upload
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const token = getToken();
    if (!token) { if (uploadStatus) uploadStatus.textContent = "enter admin key first"; return; }
    const file = fileInput.files?.[0];
    if (!file && mCategory.value === "Binaries") { if (uploadStatus) uploadStatus.textContent = "select a file"; return; }

    uploadBtn.disabled = true;
    if (uploadStatus) uploadStatus.textContent = "signing...";
    progressWrap?.classList.remove("hidden");

    try {
      let downloadUrl = "", fileKey = "";

      if (file) {
        const signRes = await fetch("/api/sign-upload", {
          method: "POST",
          headers: { "Content-Type": "application/json", "x-admin-token": token },
          body: JSON.stringify({
            filename: file.name,
            contentType: file.type || "application/octet-stream",
            sizeBytes: file.size,
            platform: mPlatform.value,
            version: mVersion.value,
          }),
        });
        if (!signRes.ok) { const e = await signRes.json().catch(() => ({})); throw new Error(e.error || `sign failed ${signRes.status}`); }
        const signData = await signRes.json();
        downloadUrl = signData.downloadUrl;
        fileKey = signData.fileKey;

        if (uploadStatus) uploadStatus.textContent = "uploading to R2...";
        await new Promise<void>((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.upload.onprogress = (ev) => {
            if (ev.lengthComputable) {
              const pct = Math.round((ev.loaded / ev.total) * 100);
              if (progressBar) progressBar.style.width = `${pct}%`;
              if (progressText) progressText.textContent = `${pct}%`;
            }
          };
          xhr.onload = () => (xhr.status >= 200 && xhr.status < 300) ? resolve() : reject(new Error(`R2 PUT ${xhr.status}`));
          xhr.onerror = () => reject(new Error("network error"));
          xhr.open("PUT", signData.uploadUrl, true);
          xhr.setRequestHeader("Content-Type", file.type || "application/octet-stream");
          xhr.send(file);
        });
      }

      if (uploadStatus) uploadStatus.textContent = "registering...";
      const tags = mTags.value.split(",").map(t => t.trim()).filter(Boolean);
      const metaRes = await fetch("/api/tools", {
        method: "POST",
        headers: { "Content-Type": "application/json", "x-admin-token": token },
        body: JSON.stringify({
          title: mTitle.value.trim(),
          version: mVersion.value.trim(),
          platform: mPlatform.value,
          category: mCategory.value,
          description: mDesc.value.trim(),
          tags: tags.length ? tags : [mPlatform.value],
          type: mCategory.value === "Web Apps" ? "web" : "binary",
          downloadUrl: downloadUrl || undefined,
          filename: file?.name,
          fileKey: fileKey || undefined,
          sizeBytes: file?.size,
          size: file ? `${(file.size / (1024 * 1024)).toFixed(1)} MB` : undefined,
          releaseDate: new Date().toISOString().split("T")[0],
        }),
      });
      if (!metaRes.ok) { const e = await metaRes.json().catch(() => ({})); throw new Error(e.error || "register failed"); }

      if (uploadStatus) uploadStatus.textContent = "✓ done";
      mTitle.value = ""; mVersion.value = ""; mDesc.value = ""; mTags.value = "";
      fileInput.value = "";
      loadCatalog();
    } catch (e: any) {
      if (uploadStatus) uploadStatus.textContent = `✗ ${e.message}`;
    } finally {
      uploadBtn.disabled = false;
    }
  });

  // Catalog
  async function loadCatalog() {
    if (!catalog) return;
    try {
      const r = await fetch("/api/tools");
      if (!r.ok) throw new Error("fetch failed");
      const items = await r.json();
      if (!Array.isArray(items) || items.length === 0) {
        catalog.innerHTML = `<div class="text-neutral-600 py-4 text-center">empty</div>`;
        return;
      }
      catalog.innerHTML = items.map((t: any) =>
        `<div class="flex items-center justify-between py-1 px-2 bg-neutral-800 rounded border border-neutral-700">
          <div class="truncate"><span class="text-neutral-200">${t.title}</span> <span class="text-neutral-600">${t.version || ""} · ${t.platform}</span></div>
          <button class="del-btn text-red-500 hover:text-red-400 px-1" data-id="${t.id}">×</button>
        </div>`
      ).join("");

      catalog.querySelectorAll<HTMLButtonElement>(".del-btn").forEach(btn => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-id");
          const token = getToken();
          if (!token) { alert("enter admin key"); return; }
          if (!confirm(`Delete "${id}"?`)) return;
          try {
            const r = await fetch(`/api/tools?id=${encodeURIComponent(id || "")}`, { method: "DELETE", headers: { "x-admin-token": token } });
            if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || "delete failed"); }
            loadCatalog();
          } catch (e: any) { alert(e.message); }
        });
      });
    } catch {
      catalog.innerHTML = `<div class="text-red-500 py-2 text-center">failed to load</div>`;
    }
  }

  refreshBtn?.addEventListener("click", loadCatalog);

  clearBtn?.addEventListener("click", async () => {
    const token = getToken();
    if (!token) { alert("enter admin key"); return; }
    if (!confirm("Delete ALL items?")) return;
    try {
      const r = await fetch("/api/tools?all=true", { method: "DELETE", headers: { "x-admin-token": token } });
      if (!r.ok) { const e = await r.json().catch(() => ({})); throw new Error(e.error || "clear failed"); }
      loadCatalog();
    } catch (e: any) { alert(e.message); }
  });

  loadCatalog();
</script>
