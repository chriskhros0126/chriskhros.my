---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";
import SearchFilter from "../components/SearchFilter.astro";
import initialTools from "../data/tools.json";

const totalBinaries = initialTools.filter(t => t.type === "binary").length;
const totalWebApps = initialTools.filter(t => t.type === "web").length;
---

<Layout title="CHRISKHROS.MY // Personal Tools & Binary Distribution Hub">
  <!-- Top Hero Section with SVG Text Mask & Iridescent Card -->
  <section class="w-full bg-neutral-background pt-6 pb-12 px-4 md:px-10 overflow-hidden">
    <div class="max-w-[1440px] mx-auto">
      
      <!-- Masked Heading Section: Deep dark iridescent fluid clipped through Syne font -->
      <div class="relative w-full h-[110px] md:h-[170px] mb-4 overflow-hidden flex items-end">
        <svg class="w-full h-full" viewBox="0 0 1600 150" preserveAspectRatio="xMinYMid meet">
          <defs>
            <mask id="textMask">
              <text x="0" y="120" font-family="'Syne', sans-serif" font-size="114" font-weight="800" fill="white" style="text-transform: uppercase; letter-spacing: -3px;">
                TOOLS & BINARIES
              </text>
            </mask>
          </defs>
          <foreignObject mask="url(#textMask)" width="100%" height="100%">
            <div xmlns="http://www.w3.org/1999/xhtml" class="w-full h-full relative">
              <img
                src="https://images.unsplash.com/photo-1652982261193-8160514e985b?ixid=M3w4NjU0NDF8MHwxfHNlYXJjaHwxfHxEZWVwJTIwYmxhY2slMjBhbmQlMjBkYXJrJTIwYmx1ZSUyMGlyaWRlc2NlbnQlMjBmbHVpZCUyMHdhdmVzJTIwd2l0aCUyMHN1YnRsZSUyMG1ldGFsbGljJTIwaGlnaGxpZ2h0cyUyMGFuZCUyMGxpcXVpZCUyMHRleHR1cmV8ZW58MHwwfHx8MTc3MjAyMDgzN3ww&ixlib=rb-4.1.0&w=1600&fit=crop&fm=jpg&q=80"
                alt="Deep iridescent fluid text mask"
                class="w-full h-full object-cover"
              />
            </div>
          </foreignObject>
        </svg>
      </div>

      <!-- Main Showcase Box with Iridescent Background -->
      <div class="relative w-full min-h-[580px] rounded-2xl md:rounded-[50px] overflow-hidden border border-white/10 shadow-2xl">
        <!-- Main Background: Iridescent fluid abstract with gradient overlay -->
        <div class="absolute inset-0 z-0">
          <img
            src="https://images.unsplash.com/photo-1766340118459-2af615146bcd?ixid=M3w4NjU0NDF8MHwxfHNlYXJjaHwxfHxEYXJrJTIwaXJpZGVzY2VudCUyMGZsdWlkJTIwYWJzdHJhY3QlMjByaXBwbGVzJTIwbGlxdWlkJTIwd2F2ZXMlMjBwdXJwbGUlMjBibHVlJTIwYmxhY2slMjBtZXRhbGxpYyUyMGdsb3NzeXxlbnwwfDB8fHwxNzcyMDIxNzk5fDA&ixlib=rb-4.1.0&w=1600&fit=crop&fm=jpg&q=80"
            alt="Iridescent fluid background"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/50 to-black/75"></div>
          <div class="absolute inset-0 opacity-[0.04] pointer-events-none" style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png');"></div>
        </div>

        <!-- Content Overlay -->
        <div class="relative z-10 w-full h-full grid grid-cols-1 lg:grid-cols-[380px_1fr] p-8 md:p-14 min-h-[580px]">
          
          <!-- Left Column -->
          <div class="flex flex-col justify-between relative z-20">
            <div>
              <!-- Interactive Glassmorphic Badge with Pulse Glow -->
              <div class="relative w-20 h-20 mb-8 group">
                <div class="absolute inset-0 bg-brand-vibrant-teal/20 rounded-full blur-2xl group-hover:bg-brand-vibrant-purple/30 transition-all duration-700"></div>
                <div class="relative w-full h-full bg-white/10 border border-white/20 backdrop-blur-xl rounded-[24px] flex items-center justify-center overflow-hidden shadow-2xl transform group-hover:rotate-6 transition-transform duration-500">
                  <div class="absolute -inset-2 bg-gradient-to-br from-brand-vibrant-purple/20 via-transparent to-brand-vibrant-teal/20 animate-pulse"></div>
                  <svg class="w-8 h-8 text-white group-hover:text-brand-vibrant-purple transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
              </div>

              <p class="text-xl md:text-2xl font-primary font-bold text-white tracking-tight">
                High-throughput binary distribution
              </p>
              <p class="text-sm font-secondary text-white/70 mt-2">
                Engineered for Cloudflare Pages + R2 ecosystem
              </p>

              <!-- Pill tags -->
              <div class="mt-6 flex flex-wrap gap-2 text-xs font-mono">
                <span class="px-3 py-1 rounded-full bg-white/10 text-white/90 border border-white/15 backdrop-blur-md">
                  100MB – 250MB+ Direct S3 PUT
                </span>
                <span class="px-3 py-1 rounded-full bg-white/10 text-white/90 border border-white/15 backdrop-blur-md">
                  Zero Egress Bandwidth Fees
                </span>
              </div>
            </div>
          </div>

          <!-- Right Column -->
          <div class="flex flex-col justify-between items-start lg:items-end lg:pr-6 mt-10 lg:mt-0 relative z-20">
            <div class="max-w-lg lg:text-left">
              <p class="text-lg md:text-xl font-secondary text-white/90 leading-relaxed mb-8">
                Personal tools, compiled desktop executables, and zero-latency browser utilities engineered to run directly on the Cloudflare edge, bypassing standard proxy limits via direct S3 pre-signed streaming.
              </p>
              
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href="#tools-section"
                  class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-text-dark hover:bg-brand-primary font-secondary text-base font-bold rounded-full hover:scale-105 transition-all duration-300 shadow-xl shadow-white/10"
                >
                  Explore Catalog
                </a>
                <a
                  href="/tools/demo-tool"
                  class="inline-flex items-center justify-center px-7 py-3.5 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-secondary text-base font-semibold rounded-full hover:scale-105 transition-all duration-300 backdrop-blur-md"
                >
                  Launch DevForge
                </a>
              </div>
            </div>

            <!-- Bottom Right Arrow Button (Scrolls to catalog) -->
            <div class="mt-auto self-end lg:self-end pt-10">
              <a
                href="#tools-section"
                class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-white flex items-center justify-center cursor-pointer hover:scale-110 transition-transform duration-300 group shadow-xl shadow-white/10"
                title="Scroll down to tools directory"
              >
                <svg viewBox="19.588 20.146 159.561 159.541" class="w-8 h-8 md:w-10 md:h-10 text-text-dark group-hover:translate-x-1 group-hover:translate-y-1 transition-transform">
                  <path fill="currentColor" d="M170.281 20.146v144.371L25.892 20.16l-6.27 6.268 144.421 144.393H19.588v8.866h159.561V20.146h-8.868z"></path>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Cards Section -->
  <section class="w-full bg-neutral-background py-6 px-4 md:px-10">
    <div class="max-w-[1440px] mx-auto grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-6 rounded-[28px] bg-white/80 border border-black/10 backdrop-blur-md shadow-sm">
        <div class="text-xs font-mono uppercase tracking-wider text-text-dark/50">Total Catalog</div>
        <div class="mt-2 text-3xl font-extrabold font-primary text-text-dark" id="metric-total">{initialTools.length}</div>
      </div>
      <div class="p-6 rounded-[28px] bg-white/80 border border-black/10 backdrop-blur-md shadow-sm">
        <div class="text-xs font-mono uppercase tracking-wider text-text-dark/50">Cloudflare R2 Binaries</div>
        <div class="mt-2 text-3xl font-extrabold font-primary text-blue-600">{totalBinaries}</div>
      </div>
      <div class="p-6 rounded-[28px] bg-white/80 border border-black/10 backdrop-blur-md shadow-sm">
        <div class="text-xs font-mono uppercase tracking-wider text-text-dark/50">In-Browser Apps</div>
        <div class="mt-2 text-3xl font-extrabold font-primary text-teal-700">{totalWebApps}</div>
      </div>
      <div class="p-6 rounded-[28px] bg-white/80 border border-black/10 backdrop-blur-md shadow-sm">
        <div class="text-xs font-mono uppercase tracking-wider text-text-dark/50">Storage Engine</div>
        <div class="mt-2 text-2xl font-extrabold font-primary text-purple-600">Cloudflare R2</div>
      </div>
    </div>
  </section>

  <!-- Tools Directory Section -->
  <section id="tools-section" class="w-full bg-neutral-background py-10 px-4 md:px-10">
    <div class="max-w-[1440px] mx-auto">
      
      <div class="mb-8">
        <h2 class="font-primary text-3xl md:text-5xl font-extrabold text-text-dark tracking-tight">
          Tools Directory
        </h2>
        <p class="text-sm font-secondary text-text-dark/60 mt-1">
          Direct R2 downloads and browser-executed client utilities
        </p>
      </div>

      <!-- Search & Filter Bar -->
      <SearchFilter totalTools={initialTools.length} />

      <!-- Tools Grid -->
      <div id="tools-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {initialTools.map((tool) => (
          <ToolCard {...tool} />
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class={`${initialTools.length === 0 ? '' : 'hidden'} text-center py-20 px-4 rounded-[40px] border border-dashed border-black/20 bg-white/50 mt-8 backdrop-blur-sm`}>
        <div class="w-16 h-16 mx-auto rounded-full bg-black/5 flex items-center justify-center text-text-dark/40 mb-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="font-primary text-2xl font-bold text-text-dark">Catalog is currently empty</h3>
        <p class="text-sm font-secondary text-text-dark/60 mt-2 max-w-md mx-auto">
          No binaries or tools published yet. Visit the <a href="/admin" class="text-purple-600 underline hover:text-purple-700 font-semibold">Admin Console</a> to stream your first release directly into Cloudflare R2!
        </p>
      </div>

      <!-- Admin Upload Banner -->
      <div class="mt-16 p-8 md:p-12 rounded-[40px] bg-text-dark text-white border border-white/10 shadow-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="text-xs font-mono text-brand-vibrant-teal flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-brand-vibrant-teal animate-pulse"></span>
            Direct S3 Multipart & Presigned Architecture
          </div>
          <h4 class="font-primary text-2xl md:text-3xl font-bold text-white">Deploy a binary or tool release</h4>
          <p class="text-sm font-secondary text-white/70 leading-relaxed">
            Use the secure upload console to stream files directly into Cloudflare R2 with automatic presigned PUT signatures and SHA-256 integrity verification.
          </p>
        </div>
        <a
          href="/admin"
          class="flex-shrink-0 inline-flex items-center gap-2 px-8 py-3.5 rounded-full bg-white text-text-dark hover:bg-brand-primary font-secondary font-bold text-sm transition-all hover:scale-105 shadow-xl"
        >
          <span>Open Admin Console</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- Live Dynamic Sync Script -->
  <script>
    async function syncLiveCatalog() {
      try {
        const res = await fetch("/api/tools");
        if (!res.ok) return;
        const liveTools = await res.json();
        if (!Array.isArray(liveTools)) return;

        const liveIds = new Set(liveTools.map((t: any) => t.id));
        const cards = document.querySelectorAll<HTMLElement>(".tool-card");

        // Remove any cards that were deleted from the live R2 catalog
        cards.forEach((card) => {
          const id = card.getAttribute("data-id");
          if (id && !liveIds.has(id)) {
            card.remove();
          }
        });

        // Update metrics
        const metricTotal = document.getElementById("metric-total");
        if (metricTotal) metricTotal.textContent = String(liveTools.length);

        const remainingCards = document.querySelectorAll<HTMLElement>(".tool-card");
        const resultsCount = document.getElementById("results-count");
        if (resultsCount) {
          resultsCount.textContent = `Showing ${remainingCards.length} of ${remainingCards.length} tools`;
        }

        const emptyState = document.getElementById("empty-state");
        if (emptyState) {
          if (remainingCards.length === 0) {
            emptyState.classList.remove("hidden");
          } else {
            emptyState.classList.add("hidden");
          }
        }
      } catch {
        // Fallback silently to pre-rendered tools
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", syncLiveCatalog);
    } else {
      syncLiveCatalog();
    }
  </script>
</Layout>
