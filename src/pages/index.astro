---
import Layout from "../layouts/Layout.astro";
---

<Layout title="chriskhros.my // File Explorer">
  <!-- Floating Scale Slider in Top-Right Corner (Outside Explorer) -->
  <div class="fixed top-4 right-4 z-50 flex items-center gap-1.5 bg-[#222]/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-[#444] shadow-xl text-xs font-mono text-[#ccc] select-none">
    <span class="text-[#888] text-[11px]">Zoom:</span>
    <button type="button" id="zoom-out" class="w-6 h-6 flex items-center justify-center rounded bg-[#333] hover:bg-[#444] text-[#ccc] hover:text-white cursor-pointer select-none text-xs transition-colors" title="Zoom Out">−</button>
    <input type="range" id="scale-slider" min="70" max="130" value="100" step="5" class="w-20 h-1 accent-[#007acc] cursor-pointer" title="Adjust Scale" />
    <button type="button" id="zoom-in" class="w-6 h-6 flex items-center justify-center rounded bg-[#333] hover:bg-[#444] text-[#ccc] hover:text-white cursor-pointer select-none text-xs transition-colors" title="Zoom In">+</button>
    <span id="scale-val" class="w-9 text-right text-white font-medium text-[11px]">100%</span>
  </div>

  <div class="flex items-center justify-center min-h-screen p-4 sm:p-8">
    <!-- Explorer Window Container -->
    <div id="explorer" class="w-full max-w-5xl flex flex-col rounded-lg overflow-hidden border border-[#444] shadow-2xl shadow-black/60 transition-transform origin-top" style="min-height: 600px; max-height: 85vh;">

      <!-- Title Bar -->
      <div class="flex items-center justify-between px-3 h-8 bg-[#2d2d2d] border-b border-[#444] select-none flex-shrink-0">
        <div class="flex items-center gap-2 text-xs text-[#ccc]">
          <span>📁</span>
          <span id="window-title">chriskhros.my</span>
        </div>
        <div class="flex items-center gap-0.5">
          <span class="w-10 h-7 flex items-center justify-center text-[#888] hover:bg-[#3c3c3c] text-xs cursor-default">─</span>
          <span class="w-10 h-7 flex items-center justify-center text-[#888] hover:bg-[#3c3c3c] text-xs cursor-default">☐</span>
          <span class="w-10 h-7 flex items-center justify-center text-[#888] hover:bg-[#c42b1c] hover:text-white text-xs cursor-default">✕</span>
        </div>
      </div>

      <!-- Navigation & Address Bar Area -->
      <div class="flex items-center px-2 py-1.5 bg-[#2d2d2d] border-b border-[#3a3a3a] gap-2 flex-shrink-0">
        <!-- Back, Forward, Up Navigation Buttons -->
        <div class="flex items-center gap-0.5 flex-shrink-0">
          <button
            type="button"
            id="nav-back"
            disabled
            class="w-7 h-7 flex items-center justify-center rounded text-sm text-[#888] hover:text-white hover:bg-[#3c3c3c] disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-[#888] cursor-pointer disabled:cursor-default transition-colors"
            title="Back (Alt+Left)"
          >
            ←
          </button>
          <button
            type="button"
            id="nav-forward"
            disabled
            class="w-7 h-7 flex items-center justify-center rounded text-sm text-[#888] hover:text-white hover:bg-[#3c3c3c] disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-[#888] cursor-pointer disabled:cursor-default transition-colors"
            title="Forward (Alt+Right)"
          >
            →
          </button>
          <button
            type="button"
            id="nav-up"
            disabled
            class="w-7 h-7 flex items-center justify-center rounded text-sm text-[#888] hover:text-white hover:bg-[#3c3c3c] disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-[#888] cursor-pointer disabled:cursor-default transition-colors"
            title="Up to root (Alt+Up)"
          >
            ↑
          </button>
        </div>

        <!-- Address Bar (Breadcrumb) -->
        <div class="flex-1 flex items-center justify-between px-2.5 py-1 bg-[#3c3c3c] border border-[#4f4f4f] rounded text-xs min-w-0">
          <div id="breadcrumb" class="flex items-center gap-1.5 truncate text-[#aaa]">
            <span>📁 This PC</span>
            <span class="text-[#666]">›</span>
            <span class="text-white font-medium">chriskhros.my</span>
          </div>
          <button type="button" id="refresh-view-btn" class="text-[#888] hover:text-white px-1 ml-2 text-xs flex-shrink-0 cursor-pointer" title="Refresh">
            ⟳
          </button>
        </div>

        <!-- Instant Search Box -->
        <div class="flex-shrink-0">
          <input
            type="text"
            id="search"
            placeholder="🔍 Search..."
            class="w-40 sm:w-52 px-3 py-1 text-xs bg-[#3c3c3c] border border-[#555] rounded text-[#ccc] placeholder-[#777] focus:outline-none focus:border-[#007acc]"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>

      <!-- Column Headers -->
      <div id="col-headers" class="flex items-center px-3 py-1.5 bg-[#2d2d2d] border-b border-[#444] text-[10px] uppercase tracking-wider text-[#888] select-none flex-shrink-0">
        <div class="flex-1 min-w-0">Name</div>
        <div class="w-24 text-center hidden sm:block">Type</div>
        <div class="w-20 text-right hidden sm:block">Size</div>
        <div class="w-28 text-center hidden md:block">Platform</div>
        <div class="w-24 text-right hidden md:block">Date Modified</div>
      </div>

      <!-- File / Folder Content Area -->
      <div id="file-list" class="flex-1 overflow-y-auto bg-[#1e1e1e]">
        <div class="flex items-center justify-center h-full text-[#555] text-sm">Loading folder contents...</div>
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="hidden flex-1 flex flex-col items-center justify-center bg-[#1e1e1e] text-[#555] text-sm p-6 text-center">
        <span class="text-3xl mb-2">📁</span>
        <span>This folder is empty.</span>
      </div>

      <!-- Status Bar -->
      <div class="flex items-center justify-between px-3 py-1 bg-[#2d2d2d] border-t border-[#444] text-[11px] text-[#888] select-none flex-shrink-0">
        <span id="item-count">0 items</span>
        <span class="text-[10px] text-[#666]">chriskhros.my · Cloudflare R2</span>
      </div>

    </div>
  </div>

  <script>
    // Elements
    const explorer = document.getElementById("explorer");
    const scaleSlider = document.getElementById("scale-slider") as HTMLInputElement;
    const scaleVal = document.getElementById("scale-val");
    const zoomOut = document.getElementById("zoom-out");
    const zoomIn = document.getElementById("zoom-in");

    const navBack = document.getElementById("nav-back") as HTMLButtonElement;
    const navForward = document.getElementById("nav-forward") as HTMLButtonElement;
    const navUp = document.getElementById("nav-up") as HTMLButtonElement;
    const breadcrumb = document.getElementById("breadcrumb");
    const windowTitle = document.getElementById("window-title");
    const searchInput = document.getElementById("search") as HTMLInputElement;
    const fileList = document.getElementById("file-list");
    const emptyState = document.getElementById("empty-state");
    const itemCount = document.getElementById("item-count");
    const refreshViewBtn = document.getElementById("refresh-view-btn");

    // State
    // Folders: 'root' | 'apps' | 'web'
    let currentFolder: "root" | "apps" | "web" = "root";
    let history: ("root" | "apps" | "web")[] = ["root"];
    let historyIndex = 0;
    let searchQuery = "";
    let selectedRow: HTMLElement | null = null;
    let allTools: any[] = [];

    // --- 1. Scale Slider (Outside Explorer Window) ---
    function applyScale(val: number) {
      const pct = Math.max(70, Math.min(130, val));
      if (scaleSlider) scaleSlider.value = String(pct);
      if (scaleVal) scaleVal.textContent = `${pct}%`;
      if (explorer) (explorer.style as any).zoom = `${pct}%`;
      localStorage.setItem("ck_explorer_scale", String(pct));
    }

    scaleSlider?.addEventListener("input", () => {
      applyScale(parseInt(scaleSlider.value, 10));
    });

    zoomOut?.addEventListener("click", () => {
      applyScale(parseInt(scaleSlider.value, 10) - 5);
    });

    zoomIn?.addEventListener("click", () => {
      applyScale(parseInt(scaleSlider.value, 10) + 5);
    });

    const savedScale = parseInt(localStorage.getItem("ck_explorer_scale") || "100", 10);
    if (savedScale && savedScale !== 100) {
      applyScale(savedScale);
    }

    // --- 2. Navigation State Machine (Back, Forward, Up) ---
    function updateNavButtons() {
      if (navBack) navBack.disabled = historyIndex <= 0;
      if (navForward) navForward.disabled = historyIndex >= history.length - 1;
      if (navUp) navUp.disabled = currentFolder === "root";
    }

    function navigateTo(folder: "root" | "apps" | "web", pushHistory = true) {
      if (pushHistory) {
        history = history.slice(0, historyIndex + 1);
        history.push(folder);
        historyIndex = history.length - 1;
      }
      currentFolder = folder;
      searchQuery = "";
      if (searchInput) searchInput.value = "";
      updateNavButtons();
      updateBreadcrumb();
      renderFolder();
    }

    function goBack() {
      if (historyIndex > 0) {
        historyIndex--;
        currentFolder = history[historyIndex];
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        updateNavButtons();
        updateBreadcrumb();
        renderFolder();
      }
    }

    function goForward() {
      if (historyIndex < history.length - 1) {
        historyIndex++;
        currentFolder = history[historyIndex];
        searchQuery = "";
        if (searchInput) searchInput.value = "";
        updateNavButtons();
        updateBreadcrumb();
        renderFolder();
      }
    }

    function goUp() {
      if (currentFolder !== "root") {
        navigateTo("root");
      }
    }

    navBack?.addEventListener("click", goBack);
    navForward?.addEventListener("click", goForward);
    navUp?.addEventListener("click", goUp);
    refreshViewBtn?.addEventListener("click", () => loadTools());

    // Keyboard navigation: Alt+Left / Alt+Right / Alt+Up
    window.addEventListener("keydown", (e) => {
      if (e.altKey && e.key === "ArrowLeft") {
        e.preventDefault();
        goBack();
      } else if (e.altKey && e.key === "ArrowRight") {
        e.preventDefault();
        goForward();
      } else if (e.altKey && e.key === "ArrowUp") {
        e.preventDefault();
        goUp();
      } else if (e.key === "/" && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      }
    });

    // --- 3. Breadcrumb & Title Update ---
    function updateBreadcrumb() {
      if (!breadcrumb) return;

      if (currentFolder === "root") {
        breadcrumb.innerHTML = `
          <span>📁 This PC</span>
          <span class="text-[#666]">›</span>
          <span class="text-white font-medium">chriskhros.my</span>
        `;
        if (windowTitle) windowTitle.textContent = "chriskhros.my";
        if (searchInput) searchInput.placeholder = "🔍 Search chriskhros.my...";
      } else if (currentFolder === "apps") {
        breadcrumb.innerHTML = `
          <span>📁 This PC</span>
          <span class="text-[#666]">›</span>
          <button type="button" id="crumb-root" class="hover:underline text-[#aaa] cursor-pointer">chriskhros.my</button>
          <span class="text-[#666]">›</span>
          <span class="text-white font-medium">Apps</span>
        `;
        if (windowTitle) windowTitle.textContent = "Apps - chriskhros.my";
        if (searchInput) searchInput.placeholder = "🔍 Search in Apps...";
      } else if (currentFolder === "web") {
        breadcrumb.innerHTML = `
          <span>📁 This PC</span>
          <span class="text-[#666]">›</span>
          <button type="button" id="crumb-root" class="hover:underline text-[#aaa] cursor-pointer">chriskhros.my</button>
          <span class="text-[#666]">›</span>
          <span class="text-white font-medium">Web Tools</span>
        `;
        if (windowTitle) windowTitle.textContent = "Web Tools - chriskhros.my";
        if (searchInput) searchInput.placeholder = "🔍 Search in Web Tools...";
      }

      document.getElementById("crumb-root")?.addEventListener("click", () => navigateTo("root"));
    }

    // --- 4. Render Logic ---
    function getFileIcon(tool: any): string {
      if (tool.type === "web") return "🌐";
      const fn = (tool.filename || "").toLowerCase();
      if (fn.endsWith(".dmg")) return "💿";
      if (fn.endsWith(".tar.gz") || fn.endsWith(".tgz")) return "📄";
      return "📦";
    }

    function getFileType(tool: any): string {
      if (tool.type === "web") return "Web App";
      if (tool.filename) {
        const parts = tool.filename.split(".");
        if (parts.length > 1) return "." + parts[parts.length - 1];
      }
      return "Binary";
    }

    function renderFolder() {
      if (!fileList) return;

      const binaries = allTools.filter(t => t.type === "binary" || (t.type !== "web" && t.downloadUrl));
      const webTools = allTools.filter(t => t.type === "web" || !t.downloadUrl);

      // Search Mode (global if searching)
      if (searchQuery) {
        const matches = allTools.filter(t => {
          const title = (t.title || "").toLowerCase();
          const tags = (t.tags || []).join(",").toLowerCase();
          const fn = (t.filename || "").toLowerCase();
          return title.includes(searchQuery) || tags.includes(searchQuery) || fn.includes(searchQuery);
        });

        if (matches.length === 0) {
          fileList.classList.add("hidden");
          emptyState?.classList.remove("hidden");
        } else {
          fileList.classList.remove("hidden");
          emptyState?.classList.add("hidden");
        }

        fileList.innerHTML = matches.map(renderItemRow).join("");
        if (itemCount) itemCount.textContent = `${matches.length} search result${matches.length !== 1 ? "s" : ""}`;
        attachRowListeners();
        return;
      }

      // Root View: Show 2 Folders (Apps & Web Tools)
      if (currentFolder === "root") {
        fileList.classList.remove("hidden");
        emptyState?.classList.add("hidden");

        fileList.innerHTML = `
          <!-- Apps Folder Row -->
          <div
            class="folder-row flex items-center px-3 py-2 border-b border-[#2a2a2a] hover:bg-[#2a2a2a] cursor-pointer text-[13px] text-[#ccc] transition-colors duration-75 select-none"
            data-target="apps"
          >
            <div class="flex-1 min-w-0 flex items-center gap-2.5 truncate font-medium">
              <span class="text-base flex-shrink-0">📁</span>
              <span class="truncate font-mono text-[13px] text-white">Apps</span>
              <span class="text-[10px] text-[#777] font-mono">(${binaries.length} binaries)</span>
            </div>
            <div class="w-24 text-center text-xs text-[#888] hidden sm:block font-mono">File folder</div>
            <div class="w-20 text-right text-xs text-[#888] hidden sm:block">${binaries.length} item${binaries.length !== 1 ? 's' : ''}</div>
            <div class="w-28 text-center text-xs text-[#888] hidden md:block">Win / Mac / Linux</div>
            <div class="w-24 text-right text-xs text-[#666] hidden md:block">—</div>
          </div>

          <!-- Web Tools Folder Row -->
          <div
            class="folder-row flex items-center px-3 py-2 border-b border-[#2a2a2a] hover:bg-[#2a2a2a] cursor-pointer text-[13px] text-[#ccc] transition-colors duration-75 select-none"
            data-target="web"
          >
            <div class="flex-1 min-w-0 flex items-center gap-2.5 truncate font-medium">
              <span class="text-base flex-shrink-0">📁</span>
              <span class="truncate font-mono text-[13px] text-white">Web Tools</span>
              <span class="text-[10px] text-[#777] font-mono">(${webTools.length} utilities)</span>
            </div>
            <div class="w-24 text-center text-xs text-[#888] hidden sm:block font-mono">File folder</div>
            <div class="w-20 text-right text-xs text-[#888] hidden sm:block">${webTools.length} item${webTools.length !== 1 ? 's' : ''}</div>
            <div class="w-28 text-center text-xs text-[#888] hidden md:block">Browser Native</div>
            <div class="w-24 text-right text-xs text-[#666] hidden md:block">—</div>
          </div>
        `;

        if (itemCount) itemCount.textContent = "2 folders";

        // Folder click handlers
        fileList.querySelectorAll<HTMLElement>(".folder-row").forEach(row => {
          row.addEventListener("click", () => {
            const target = row.getAttribute("data-target") as "apps" | "web";
            if (target) navigateTo(target);
          });
        });
        return;
      }

      // Apps Folder View
      if (currentFolder === "apps") {
        if (binaries.length === 0) {
          fileList.classList.add("hidden");
          emptyState?.classList.remove("hidden");
        } else {
          fileList.classList.remove("hidden");
          emptyState?.classList.add("hidden");
        }

        fileList.innerHTML = binaries.map(renderItemRow).join("");
        if (itemCount) itemCount.textContent = `${binaries.length} item${binaries.length !== 1 ? "s" : ""}`;
        attachRowListeners();
        return;
      }

      // Web Tools Folder View
      if (currentFolder === "web") {
        if (webTools.length === 0) {
          fileList.classList.add("hidden");
          emptyState?.classList.remove("hidden");
        } else {
          fileList.classList.remove("hidden");
          emptyState?.classList.add("hidden");
        }

        fileList.innerHTML = webTools.map(renderItemRow).join("");
        if (itemCount) itemCount.textContent = `${webTools.length} item${webTools.length !== 1 ? "s" : ""}`;
        attachRowListeners();
        return;
      }
    }

    function renderItemRow(tool: any): string {
      const isWeb = tool.type === "web";
      const icon = getFileIcon(tool);
      const fileType = getFileType(tool);
      const href = isWeb ? (tool.route || "/tools/demo-tool") : (tool.downloadUrl || "#");
      const dl = !isWeb ? ` download="${tool.filename || ""}"` : "";

      return `
        <a
          href="${href}"
          ${dl}
          class="file-row flex items-center px-3 py-1.5 border-b border-[#2a2a2a] hover:bg-[#2a2a2a] cursor-pointer text-[13px] no-underline text-[#ccc] transition-colors duration-75 select-none"
          data-id="${tool.id}"
        >
          <div class="flex-1 min-w-0 flex items-center gap-2 truncate">
            <span class="text-sm flex-shrink-0">${icon}</span>
            <span class="truncate font-mono text-[13px] text-neutral-200">${tool.title || "Untitled"}</span>
            ${tool.version ? `<span class="text-[10px] text-[#666] flex-shrink-0 font-mono">${tool.version}</span>` : ""}
          </div>
          <div class="w-24 text-center text-xs text-[#888] hidden sm:block font-mono">${fileType}</div>
          <div class="w-20 text-right text-xs text-[#888] hidden sm:block">${isWeb ? "—" : (tool.size || "—")}</div>
          <div class="w-28 text-center text-xs text-[#888] hidden md:block">${tool.platform || "—"}</div>
          <div class="w-24 text-right text-xs text-[#666] hidden md:block">${tool.releaseDate || "—"}</div>
        </a>
      `;
    }

    function attachRowListeners() {
      fileList?.querySelectorAll<HTMLElement>(".file-row").forEach(row => {
        row.addEventListener("mousedown", () => {
          if (selectedRow) selectedRow.style.backgroundColor = "";
          selectedRow = row;
          row.style.backgroundColor = "#264f78";
        });
      });
    }

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest(".file-row") && !target.closest(".folder-row") && selectedRow) {
        selectedRow.style.backgroundColor = "";
        selectedRow = null;
      }
    });

    searchInput?.addEventListener("input", () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      renderFolder();
    });

    // --- 5. Dynamic Data Fetch from R2 ---
    async function loadTools() {
      try {
        const res = await fetch("/api/tools");
        if (res.ok) {
          const data = await res.json();
          if (Array.isArray(data)) {
            allTools = data;
            renderFolder();
            return;
          }
        }
      } catch (err) {
        console.warn("Failed to load catalog from API:", err);
      }
      allTools = [];
      renderFolder();
    }

    // Initialize
    updateNavButtons();
    updateBreadcrumb();
    loadTools();
  </script>
</Layout>
