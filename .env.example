# Cloudflare Pages & R2 Environment Configuration
# Copy this to .env or configure in Cloudflare Pages Dashboard -> Settings -> Environment variables

# Admin Authentication Secret (Protects /admin uploads & signing endpoints)
ADMIN_SECRET_KEY=your_secure_admin_token_here

# Cloudflare Account ID (Found in CF Dashboard -> Overview / R2)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 S3 API Token (Found in CF Dashboard -> R2 -> Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 Bucket Name
R2_BUCKET_NAME=chriskhros-binaries

# Public Base URL for Downloads (Can be your custom domain like https://dl.chriskhros.my or R2 public r2.dev domain)
R2_PUBLIC_URL=https://dl.chriskhros.my
